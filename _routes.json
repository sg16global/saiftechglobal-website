{
  "version": 1,
  "description": "Run Functions only for the API and for private paths that must return 404 (see functions/_middleware.js).",
  "include": [
    "/api/*",
    "/server/*",
    "/runner/*",
    "/migrations/*",
    "/tests/*",
    "/docs/*",
    "/scripts/*",
    "/_musa-react-src/*",
    "/_internal/*",
    "/.wrangler/*",
    "/node_modules/*",
    "/wrangler.toml",
    "/.dev.vars",
    "/.gitignore",
    "/package.json",
    "/package-lock.json",
    "/_routes.json"
  ],
  "exclude": []
}
